{
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "no_checkable_progress",
        "useful_negative_result",
        "partial_progress",
        "candidate_counterexample",
        "candidate_solution",
        "known_resolution"
      ]
    },
    "summary": {
      "type": "string"
    },
    "novelty_status": {
      "type": "string",
      "enum": [
        "apparently_new",
        "known_result_reconstruction",
        "new_extension",
        "mixed",
        "unknown"
      ]
    },
    "external_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string"},
          "used_for": {"type": "string"},
          "verification": {"type": "string"}
        },
        "required": ["title", "url", "used_for", "verification"],
        "additionalProperties": false
      }
    },
    "checkable_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "proof",
              "lemma",
              "counterexample",
              "computation",
              "reduction",
              "reformulation",
              "obstruction",
              "other"
            ]
          },
          "statement": {
            "type": "string"
          },
          "support": {
            "type": "string"
          },
          "remaining_gap": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "statement",
          "support",
          "remaining_gap"
        ],
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "status",
    "summary",
    "novelty_status",
    "external_sources",
    "checkable_claims",
    "artifacts",
    "warnings"
  ],
  "additionalProperties": false
}
