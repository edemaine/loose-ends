{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "published": { "type": "string" },
    "updated": { "type": "string" }
  },
  "required": ["title", "authors", "published", "updated"],
  "additionalProperties": false
}
