{
  "type": "object",
  "properties": {
    "correctness": {
      "type": "string",
      "enum": [
        "not_applicable",
        "incorrect",
        "major_gaps",
        "minor_gaps",
        "plausible",
        "well_supported"
      ]
    },
    "reviewed_coverage": {
      "type": "string",
      "enum": [
        "none",
        "auxiliary",
        "special_case",
        "partial",
        "near_complete",
        "complete_under_stated_interpretation",
        "complete"
      ]
    },
    "importance": {
      "type": "string",
      "enum": ["none", "minor", "moderate", "major", "resolution"]
    },
    "verification_confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {"type": "string"},
    "claim_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {"type": "string"},
          "assessment": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "incorrect"
            ]
          },
          "explanation": {"type": "string"}
        },
        "required": ["claim_id", "assessment", "explanation"],
        "additionalProperties": false
      }
    },
    "blocking_gaps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_next_steps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "correctness",
    "reviewed_coverage",
    "importance",
    "verification_confidence",
    "summary",
    "claim_reviews",
    "blocking_gaps",
    "recommended_next_steps",
    "warnings"
  ],
  "additionalProperties": false
}
