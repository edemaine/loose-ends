{
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "invalid",
        "no_progress",
        "useful_but_flawed",
        "plausible_progress",
        "strong_candidate"
      ]
    },
    "attention": {
      "type": "string",
      "enum": ["none", "low", "medium", "high"]
    },
    "summary": {
      "type": "string"
    },
    "claim_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "assessment": {
            "type": "string",
            "enum": [
              "supported",
              "partially_supported",
              "unsupported",
              "incorrect"
            ]
          },
          "explanation": {
            "type": "string"
          }
        },
        "required": ["claim_id", "assessment", "explanation"],
        "additionalProperties": false
      }
    },
    "blocking_gaps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "recommended_next_steps": {
      "type": "array",
      "items": {"type": "string"}
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "required": [
    "verdict",
    "attention",
    "summary",
    "claim_reviews",
    "blocking_gaps",
    "recommended_next_steps",
    "warnings"
  ],
  "additionalProperties": false
}
